# Copia este archivo a .env.deploy y completa los valores reales.
# NUNCA subas .env.deploy al repositorio.

# Neon: usa la cadena con pooler que entrega el panel.
DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Opcional: si se deja vacía, deploy.sh la deriva quitando "-pooler" del host.
DIRECT_URL=

# Token personal de Vercel (https://vercel.com/account/tokens) y scope/equipo.
VERCEL_TOKEN=vercel_token_aqui
VERCEL_SCOPE=tu-usuario-o-equipo

# Nombres únicos de los proyectos en Vercel. El script los crea si no existen.
API_PROJECT_NAME=mining-equipment-api
WEB_PROJECT_NAME=mining-equipment-web

# Dominios públicos productivos. Si no los defines se usan:
# https://<API_PROJECT_NAME>.vercel.app y https://<WEB_PROJECT_NAME>.vercel.app
# API_PUBLIC_URL=https://mining-equipment-api.vercel.app
# WEB_PUBLIC_URL=https://mining-equipment-web.vercel.app

